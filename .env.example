# Convex cloud deployment URL (ends in .convex.cloud)
NEXT_PUBLIC_CONVEX_URL=

# Convex HTTP actions URL (ends in .convex.site)
NEXT_PUBLIC_CONVEX_SITE_URL=

# Auth secret is configured on the Convex deployment, not in the browser.
# Set it with: npx convex env set AUTH_SECRET "<generated-secret>"
# Never commit real secrets or production environment values.
