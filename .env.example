# Written automatically by `npx convex dev` into .env.local.
CONVEX_DEPLOYMENT=
# Convex cloud deployment URL (ends in .convex.cloud)
NEXT_PUBLIC_CONVEX_URL=

# Auth keys (SITE_URL, JWT_PRIVATE_KEY, JWKS) live on the Convex deployment, not here.
# Set them with: npx @convex-dev/auth   (add --prod for production)
# Never commit real secrets or production environment values.
